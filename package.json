{
  "name": "territorio-app",
  "version": "0.1.0",
  "description": "Site e sistema de reservas do Território",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "build:site": "vite build --mode site",
    "build:site:ar": "vite build --mode site-ar",
    "permissoes": "node scripts/api/permissoes.mjs",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "fonts": "python scripts/fonts/build_fonts.py",
    "images": "node scripts/optimize-images.mjs",
    "test": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "lit-html": "^3.3.3",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.12.0",
    "js-yaml": "^4.3.2",
    "msw": "^3.0.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.1"
  },
  "private": true,
  "type": "module"
}
